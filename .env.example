# Copiar a .env y rellenar. Nunca commitear .env real.

# ALFRED / FRED (R4) — series macro vintage. Clave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
ALFRED_API_KEY=

# Calendario macro con consenso histórico (cuello de botella real — ver reports/data_audit.md)
TRADING_ECONOMICS_API_KEY=

# GDELT no requiere key. Placeholder por si se usa un proxy/CDN propio.
GDELT_BASE_URL=

# Coinglass (funding / liquidaciones) — verificar en reports/data_audit.md si es API real
COINGLASS_API_KEY=

# NewsAPI (alternativa/complemento a GDELT/RSS para titulares)
NEWSAPI_KEY=

# --- Modulo experimental de ingesta de sentiment/noticias (Fase 2, temporal) ---
# Esquema comun en src/irfn/data/sentiment/schema.py. 4 fuentes; GDELT no usa key.
FINNHUB_API_KEY=
APITUBE_API_KEY=
CRYPTOPANIC_API_KEY=
